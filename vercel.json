{
  "rewrites": [
    {
      "source": "/audit-express",
      "destination": "/audit-express/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
